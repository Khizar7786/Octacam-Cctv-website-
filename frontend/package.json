{
  "name": "octacam-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/route-errors.test.ts tests/api-client.test.ts tests/catalog-api.test.ts",
    "test:api:live": "node --experimental-strip-types --test tests/api-live.test.ts",
    "test:production": "node --experimental-strip-types --test tests/production.test.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "5.1.36",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.15.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.12.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
